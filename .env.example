# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto Firebase.
# Onde achar: Console Firebase > Configurações do projeto (engrenagem) > Seus aplicativos > Web (</>)
# Essas chaves do app Web NÃO são segredo (ficam visíveis no app de qualquer forma);
# quem protege os dados são as regras do Firestore (firestore.rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
